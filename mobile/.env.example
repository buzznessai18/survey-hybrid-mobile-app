# Public Supabase configuration (safe to embed in the app; access is enforced by RLS + Edge Functions).
# Local stack: run `supabase status` in the repo root. On a physical phone use your
# computer's LAN IP (e.g. http://192.168.1.20:54321), not 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Country code used to turn a 10-digit mobile number into an international phone login.
EXPO_PUBLIC_DEFAULT_COUNTRY_CODE=91

# Heading on printed farmer receipts (optional; defaults to "Field Survey").
EXPO_PUBLIC_RECEIPT_ORG_NAME=
# Optional second receipt line, e.g. office address or phone.
EXPO_PUBLIC_RECEIPT_ORG_SUBTITLE=

# NEVER add SUPABASE_SERVICE_ROLE_KEY or any other secret here.
