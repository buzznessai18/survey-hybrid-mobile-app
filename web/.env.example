# Public Supabase configuration: the SAME project the mobile app uses (mobile/.env).
# Both values are public by design; access is enforced by RLS + Edge Function role checks.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Country code used to turn a 10-digit mobile number into a phone login.
VITE_DEFAULT_COUNTRY_CODE=91

# Heading on printed farmer receipts (optional; defaults to "Field Survey").
VITE_RECEIPT_ORG_NAME=
# Optional second receipt line, e.g. office address or phone.
VITE_RECEIPT_ORG_SUBTITLE=

# NEVER add SUPABASE_SERVICE_ROLE_KEY or any other secret here.
