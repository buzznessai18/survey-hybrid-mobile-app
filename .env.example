# =============================================================================
# MOBILE APP  (the ONLY values the app may contain; both are public by design)
# =============================================================================
# Project URL: Dashboard > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Public anon / publishable key. Safe to ship: every request is limited by RLS
# and the Edge Functions' role checks.
SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Storage bucket for field photos
SUPABASE_PHOTO_BUCKET=field-photos

# =============================================================================
# EDGE FUNCTION SECRETS  (optional; server side only — NEVER put in the app)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically by Supabase. Set the optional ones below
# with:  supabase secrets set --env-file supabase/functions/.env
# =============================================================================
# Signed photo URL lifetime (seconds)
SIGNED_URL_TTL_SECONDS=3600
# Accepted farmer mobile format after normalisation (default: Indian mobiles)
MOBILE_REGEX=^[6-9]\d{9}$
# Country code stripped from +CC numbers before validation
MOBILE_COUNTRY_CODE=91
# Maximum rows in an admin CSV export
MAX_EXPORT_ROWS=10000
# CORS origin for browser-based tooling (native apps don't need CORS)
ALLOWED_ORIGIN=*

# =============================================================================
# CI / DEPLOYMENT ONLY  (never commit real values)
# =============================================================================
SUPABASE_ACCESS_TOKEN=<personal-access-token>
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=<database-password>
